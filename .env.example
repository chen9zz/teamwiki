# Local development only. Replace both passwords and JWT_SECRET before deployment.
POSTGRES_DB=teamwiki
POSTGRES_USER=teamwiki
POSTGRES_PASSWORD=teamwiki-local-password
DATABASE_URL=postgresql+asyncpg://teamwiki:teamwiki-local-password@postgres:5432/teamwiki
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
ENVIRONMENT=development
PORT=8080

