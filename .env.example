# Local HTTP demo. Generate unique secrets before running this outside your machine.
POSTGRES_DB=teamwiki
POSTGRES_USER=teamwiki
POSTGRES_PASSWORD=teamwiki-local-password
DATABASE_URL=postgresql+asyncpg://teamwiki:teamwiki-local-password@postgres:5432/teamwiki
REDIS_URL=redis://redis-cache:6379/0
CELERY_BROKER_URL=redis://redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://redis-broker:6379/1
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
ENVIRONMENT=development
PORT=8080
API_WORKERS=2
WORKER_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=2
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
REDIS_MAX_CONNECTIONS=20
REDIS_POOL_TIMEOUT_SECONDS=0.1
REDIS_SOCKET_TIMEOUT_SECONDS=0.15
REQUEST_MAX_INFLIGHT=64
